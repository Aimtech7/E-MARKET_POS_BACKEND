# ===========================
# APPLICATION
# ===========================
# Execution environment (development, staging, production)
NODE_ENV=development
# Express server listening port
PORT=5500
# Commercial retail POS brand identifier
APP_NAME=E-MARKET POS
# Application version string
APP_VERSION=1.0.0
# Allowed frontend client origin for CORS and Webhook redirection
FRONTEND_URL=http://localhost:3000
# Public domain for webhook receiving
WEBHOOK_DOMAIN=https://e-market-pos-backend.onrender.com

# ===========================
# DATABASE
# ===========================
# Primary MongoDB Atlas cloud or local database connection string
MONGODB_URI=mongodb+srv://austinemakwaka254_db_user:0723373424@aimcluster1.wrvzhgc.mongodb.net/emmarket?appName=aimcluster1
# Target database corpus name
DATABASE_NAME=emmarket
# Local offline fallback connection URI
LOCAL_MONGOPATH=mongodb://127.0.0.1:27017/emmarket_production
# Cloud MongoDB cluster path
CLOUD_MONGOPATH=mongodb+srv://austinemakwaka254_db_user:0723373424@aimcluster1.wrvzhgc.mongodb.net/emmarket?appName=aimcluster1
# Synchronized Mongo connection alias
MONGOPATH=mongodb+srv://austinemakwaka254_db_user:0723373424@aimcluster1.wrvzhgc.mongodb.net/emmarket?appName=aimcluster1

# ===========================
# JWT
# ===========================
# Cryptographic secret key for signing user authentication JSON Web Tokens
JWT_SECRET=supersecretjwtkey
# Token validity duration
JWT_EXPIRES_IN=7d
# Cryptographic secret key for long-lived refresh tokens
JWT_REFRESH_SECRET=refresh_token_secret_key_production_2026
# Refresh token validity duration
JWT_REFRESH_EXPIRES_IN=30d

# ===========================
# SESSION
# ===========================
# Express session cookie encryption secret
SESSION_SECRET=commercial_retail_session_key_production_2026

# ===========================
# MPESA DARAJA
# ===========================
# Safaricom Daraja API target sandbox or production cluster
MPESA_ENVIRONMENT=production
# Daraja OAuth app consumer key
MPESA_CONSUMER_KEY=tRAV3N4updxiOR8SZ1ArudoGllePOXvA21WBnOMAnleUpriy
# Daraja OAuth app consumer secret
MPESA_CONSUMER_SECRET=1xzniyl9gxoUL4X0WzbAPIAR8mYjAtW0EpG7izAj1zEmPHAfBx1lAGnxzHFzD43x
# Paybill or Buy Goods shortcode
MPESA_SHORTCODE=4647219
# STK Push passkey for timestamp password hashing
MPESA_PASSKEY=67747a243e5f928a9de72348a8a9fea591353383e850de56210a809a7017c744
# Publicly accessible webhook destination URL for Safaricom callback dispatch
MPESA_CALLBACK_URL=https://e-market-pos-backend.onrender.com/payments/mpesa/webhook
# Daraja STK Push transaction type (CustomerPayBillOnline or CustomerBuyGoodsOnline)
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# Maximum STK push requery timeout window
MPESA_TIMEOUT_SECONDS=60

# ===========================
# PAYSTACK
# ===========================
# Paystack public checkout key
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_public_key_2026
# Paystack secret API key for card transactions
PAYSTACK_SECRET_KEY=sk_test_placeholder_secret_key_2026
# Webhook destination for card payment verification
PAYSTACK_CALLBACK_URL=https://e-market-pos-backend.onrender.com/payments/paystack/webhook

# ===========================
# EMAIL
# ===========================
# SMTP mail server hostname for daily closing report dispatch
SMTP_HOST=smtp.gmail.com
# SMTP mail server secure port
SMTP_PORT=587
# Authenticated SMTP user email
SMTP_USER=posadmin@emarketpos.co.ke
# App password or SMTP account credential
SMTP_PASS=dev_smtp_placeholder_pass
# Default sender email address
EMAIL_FROM=noreply@emarketpos.co.ke

# ===========================
# SMS (OPTIONAL)
# ===========================
# Bulk SMS gateway API key
SMS_API_KEY=dev_sms_placeholder_key
# Registered alphanumeric SMS sender ID
SMS_SENDER_ID=EMARKET

# ===========================
# LOGGING
# ===========================
# System logging verbosity (debug, info, warn, error)
LOG_LEVEL=info

# ===========================
# BACKUP & UPLOADS & PDF
# ===========================
# Local storage destination for automated daily database archives
BACKUP_DIRECTORY=./backups
# Product image and document upload directory
UPLOADS_DIRECTORY=./uploads
# Generated invoice and receipt PDF export folder
PDF_DIRECTORY=./documents/pdf

# ===========================
# SECURITY & CORS
# ===========================
# Bcrypt password hashing cost factor
BCRYPT_ROUNDS=12
# Rate limiting window duration in milliseconds (15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum permitted API requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100
# Allowed CORS origins
CORS_ORIGIN=*

# ===========================
# ELECTRON & API & SCHEDULER
# ===========================
# Desktop Electron API entry point URL
ELECTRON_START_URL=http://localhost:5500
# Global REST API route prefix
API_PREFIX=/api
# Enable background automated closing and backup cron jobs
SCHEDULER_ENABLED=true
